# Contact form delivery (Zoho Mail SMTP)
# Check Zoho Mail's server configuration for your account and data center.
# Typical hosts: smtp.zoho.com (personal/free) or smtppro.zoho.com (paid org).
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=hello@mzfortech.com
