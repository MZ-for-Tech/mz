# Contact form delivery (Zoho Mail SMTP)
# Check Zoho Mail's server configuration for your account and data center.
# Typical hosts: smtp.zoho.com (personal/free) or smtppro.zoho.com (paid org).
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=hello@mzfortech.com
# Set this privately in .env.local and your hosting provider's environment.
# Use a Zoho application-specific password when two-factor authentication is enabled.
ZOHO_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=hello@mzfortech.com
CONTACT_TO_EMAIL=hello@mzfortech.com
